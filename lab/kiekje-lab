#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
RESULTS="${KIEKJE_LAB_RESULTS:-$REPO/lab-results}"
LIBVIRT="qemu:///system"
VM_USER="${KIEKJE_LAB_USER:-kiek}"
VM_REPO="${KIEKJE_LAB_REPO:-/home/$VM_USER/kiekje-next}"
CAPTURES="${KIEKJE_LAB_CAPTURES:-5}"
STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/kiekje-lab"
ISO_DIR="${KIEKJE_LAB_ISOS:-$HOME/vm/isos}"
SSH_KEY="${KIEKJE_LAB_KEY:-$HOME/.ssh/id_ed25519}"
OVMF_CODE="${KIEKJE_LAB_OVMF_CODE:-/usr/share/edk2/x64/OVMF_CODE.4m.fd}"
OVMF_VARS="${KIEKJE_LAB_OVMF_VARS:-/usr/share/edk2/x64/OVMF_VARS.4m.fd}"
VIRTIOFSD="${KIEKJE_LAB_VIRTIOFSD:-/usr/lib/virtiofsd}"
QEMU_IMG="${KIEKJE_LAB_QEMU_IMG:-/usr/bin/qemu-img}"
BOOTSTRAP_PORT="${KIEKJE_LAB_PORT:-8649}"
STEPS=(new installed bootstrap provision sync install snapshot)

declare -A PACKAGES=(
    [arch]="gcc make pkgconf gtk4 gtk4-layer-shell wayland dbus xdg-desktop-portal rsync curl"
    [fedora]="gcc make pkgconf-pkg-config gtk4-devel gtk4-layer-shell-devel wayland-devel dbus xdg-desktop-portal rsync curl"
    [debian]="build-essential pkg-config libgtk-4-dev libgtk4-layer-shell-dev libwayland-dev dbus xdg-desktop-portal rsync curl"
    [suse]="gcc make pkg-config gtk4-devel gtk4-layer-shell-devel wayland-devel dbus-1 xdg-desktop-portal rsync curl"
)
declare -A PORTALS=(
    [gnome]=xdg-desktop-portal-gnome
    [kde]=xdg-desktop-portal-kde
    [hyprland]=xdg-desktop-portal-hyprland
    [sway]=xdg-desktop-portal-wlr
    [other]=xdg-desktop-portal-gtk
)

HELP_GROUPS=(
    "Test this session"
    "env||Print what this machine and session are"
    "run|[--no-interactive|--driven] [--layout <name>]|Build, test and log this session to lab-results/"
    "results||Summarize every run of every machine"
    "Drive a VM"
    "vms||List VMs with state, address, distro and snapshot"
    "start|<vm>|Boot a VM and open its screen"
    "run-vm|<vm> [--auto] [--layout <name>]|Run the tests in a VM; --auto drives the overlay checks"
    "all|[vm...] [--layout <name>]|Reset, sync and --auto test every ready VM, then summarize"
    "ssh|<vm> [cmd]|Open a shell or run a command in the VM"
    "stop|<vm>|Shut a VM down"
    "Create a VM"
    "doctor-host||Check that this host can run lab VMs"
    "up|<vm> [iso]|Create, wait for the install, then bootstrap to snapshot"
    "new|<vm> <iso|url>|Create a VM from an ISO or download URL"
    "iso|<vm> <iso|url|--eject>|Swap or eject the install medium"
    "Setup steps, run in order by up"
    "bootstrap|<vm>|Enable SSH, the guest agent and your key"
