HELP_FLAGS=(
    "--ram|<size>|Memory for new and up (default: 6G)"
    "--cpus|<n>|Virtual CPUs for new and up (default: 4)"
    "--disk|<size>|Disk size for new and up (default: 40G)"
    "--no-3d||Turn off 3D acceleration for new and up"
    "--layout|<name>|single (default), scale (first output at 1.5), multi (adds a 1920x1200 output at 1.5 left of it and drags there) or rotated (the same output at 2.0, turned 90 degrees); sway and Hyprland only"
